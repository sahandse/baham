PORT=4000
# Comma-separated list of allowed frontend origins, e.g.:
# ALLOWED_ORIGINS=https://sahandse.github.io
# Use * (default) to allow any origin (fine for a demo, not for production).
ALLOWED_ORIGINS=*
# Where the SQLite file is written. Must be a persistent volume on most hosts
# (container filesystems are usually ephemeral otherwise).
DATA_DIR=./data
